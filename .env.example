# YouTube /youtubei/v1/att request key used by the PO-token generator.
YOUTUBE_REQUEST_KEY=O43z0dpjhgX20SCx4KAo

# Optional: YouTube browser cookies. Needed when Vercel's datacenter IP is
# bot-flagged and YouTube replies "Sign in to confirm you're not a bot"
# (LOGIN_REQUIRED) to every player request. Leave empty to fall back to
# anonymous visitor cookies.
# Minimum set: SAPISID + __Secure-3PAPISID + VISITOR_INFO1_LIVE (add
# __Secure-3PSID if you're signed in). Grab the real values from DevTools ->
# Application -> Cookies. SOCS/CONSENT are optional.
# Sample (values are placeholders — replace with your real cookies):
# YOUTUBE_COOKIES=VISITOR_INFO1_LIVE=1BvNv5_Ugt0; SAPISID=U_DRxCbfjdNOUsOQ/AyLkzzQaTWuU_0mCh; __Secure-3PAPISID=U_DRxCbfjdNOUsOQ/AyLkzzQaTWuU_0mCh; __Secure-3PSID=g.a000CA_ns-9bUyFVcIHVF9Q4OXFkmM85Y5lKILm-; NID=534=LLL63keOgoK-Cd1ZGZZo_8cRrdFtHcd0fcEel
YOUTUBE_COOKIES=

# Base URL of the LRCLib API (used by /api/lyrics for synced/plain lyrics).
LRCLIB_API_URL=https://lrclib.net/api

# User-Agent sent to LRCLib. Some public instances require a custom UA.
LYRICS_USER_AGENT=spotify-yt-player/1.0

# Full Google-translate endpoint template (client = gtx). 'q' is appended at call time.
# The 'tl' query param controls the target language (id = Indonesian).
NEXT_PUBLIC_TRANSLATE_API_URL=https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=id&dt=t

# Max number of parallel translation requests (client-side).
NEXT_PUBLIC_TRANSLATE_CONCURRENCY=6
